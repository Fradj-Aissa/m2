# SmartRentDZ Environment Configuration
# Copy this file to .env and update with your actual values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=120

# Model Configuration
MODEL_PATH=models/random_forest_model.joblib
ENCODERS_PATH=models/label_encoders.joblib

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/api.log

# Database (future use)
DATABASE_URL=postgresql://user:password@localhost:5432/smartrentdz

# Security
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False

# CORS Origins (production values)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com

# Monitoring
SENTRY_DSN=

# Cache
CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
