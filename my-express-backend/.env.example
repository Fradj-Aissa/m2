# ============================================
# SmartRent Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration
# ============================================
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartrent_db

# PostgreSQL Connection String (Alternative to individual DB vars)
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/smartrent_db

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_URL=http://localhost:5173

# For production:
# FRONTEND_URL=https://your-domain.vercel.app

# ============================================
# Authentication & Security
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================
# Admin Configuration (NEW - REQUIRED)
# ============================================
# This is the email that will be automatically promoted to admin
# when accessing protected admin routes
ADMIN_EMAIL=admin@smartrent.com

# ============================================
# ML Model API (FastAPI)
# ============================================
FASTAPI_PREDICT_URL=https://aissaf-smart-rent-ml-api.hf.space/predict

# ============================================
# Image Upload (ImgBB)
# ============================================
IMGBB_API_KEY=your_imgbb_api_key

# ============================================
# Optional - Render.com Deployment
# ============================================
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
