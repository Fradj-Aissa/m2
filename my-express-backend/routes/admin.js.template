/**
 * GET /api/admin/stats
 * Returns system statistics
 * 
 * Response:
 * {
 *   totalUsers: number,
 *   totalProperties: number,
 *   activeSubscriptions: number,
 *   pendingApprovals: number
 * }
 */
router.get("/stats", authMiddleware, adminOnly, async (req, res) => {
  try {
    // Get total users
    const usersResult = await db.query("SELECT COUNT(*) as count FROM users");
    const totalUsers = parseInt(usersResult.rows[0].count);

    // Get total properties
    const propertiesResult = await db.query(
      "SELECT COUNT(*) as count FROM apartments"
    );
    const totalProperties = parseInt(propertiesResult.rows[0].count);

    // Get pending approvals
    const pendingResult = await db.query(
      "SELECT COUNT(*) as count FROM apartments WHERE status = 'pending'"
    );
    const pendingApprovals = parseInt(pendingResult.rows[0].count);

    // TODO: Get active subscriptions from subscriptions table
    const activeSubscriptions = 0;

    res.json({
      totalUsers,
      totalProperties,
      activeSubscriptions,
      pendingApprovals,
    });
  } catch (error) {
    console.error("Error fetching stats:", error);
    res.status(500).json({ error: "Failed to fetch statistics" });
  }
});

/**
 * GET /api/admin/users
 * Returns all users
 * 
 * Response: User[]
 * {
 *   uid: string,
 *   name: string,
 *   email: string,
 *   type: "renter" | "landlord",
 *   phone: string,
 *   created_at: timestamp,
 *   status?: "active" | "inactive" | "blocked"
 * }
 */
router.get("/users", authMiddleware, adminOnly, async (req, res) => {
  try {
    const result = await db.query(
      `SELECT 
        uid, 
        name, 
        email, 
        type, 
        phone, 
        created_at
       FROM users 
       ORDER BY created_at DESC`
    );

    const users = result.rows.map((user) => ({
      ...user,
      status: "active", // TODO: Add status column to users table
    }));

    res.json(users);
  } catch (error) {
    console.error("Error fetching users:", error);
    res.status(500).json({ error: "Failed to fetch users" });
  }
});

/**
 * DELETE /api/admin/users/:uid
 * Delete a user by UID
 */
router.delete("/users/:uid", authMiddleware, adminOnly, async (req, res) => {
  try {
    const { uid } = req.params;

    // Prevent deleting self
    if (uid === req.user.uid) {
      return res
        .status(400)
        .json({ error: "Cannot delete your own account" });
    }

    // Delete user and related data (cascading deletes handled by DB)
    const result = await db.query("DELETE FROM users WHERE uid = $1 RETURNING *", [
      uid,
    ]);

    if (result.rows.length === 0) {
      return res.status(404).json({ error: "User not found" });
    }

    res.json({ message: "User deleted successfully", user: result.rows[0] });
  } catch (error) {
    console.error("Error deleting user:", error);
    res.status(500).json({ error: "Failed to delete user" });
  }
});

/**
 * GET /api/admin/properties
 * Returns all properties
 * 
 * Response: Property[]
 * {
 *   id: string,
 *   title: string,
 *   description: string,
 *   price: number,
 *   wilaya: string,
 *   landlord_name: string,
 *   status: "pending" | "approved" | "rejected",
 *   created_at: timestamp
 * }
 */
router.get("/properties", authMiddleware, adminOnly, async (req, res) => {
  try {
    const result = await db.query(
      `SELECT 
        id,
        title,
        description,
        price,
        wilaya,
        landlord_name,
        status,
        created_at
       FROM apartments
       ORDER BY created_at DESC`
    );

    res.json(result.rows);
  } catch (error) {
    console.error("Error fetching properties:", error);
    res.status(500).json({ error: "Failed to fetch properties" });
  }
});

/**
 * PUT /api/admin/properties/:id/approve
 * Approve a property
 */
router.put(
  "/properties/:id/approve",
  authMiddleware,
  adminOnly,
  async (req, res) => {
    try {
      const { id } = req.params;

      const result = await db.query(
        "UPDATE apartments SET status = 'approved' WHERE id = $1 RETURNING *",
        [id]
      );

      if (result.rows.length === 0) {
        return res.status(404).json({ error: "Property not found" });
      }

      res.json({
        message: "Property approved successfully",
        property: result.rows[0],
      });
    } catch (error) {
      console.error("Error approving property:", error);
      res.status(500).json({ error: "Failed to approve property" });
    }
  }
);

/**
 * PUT /api/admin/properties/:id/reject
 * Reject a property
 */
router.put(
  "/properties/:id/reject",
  authMiddleware,
  adminOnly,
  async (req, res) => {
    try {
      const { id } = req.params;

      const result = await db.query(
        "UPDATE apartments SET status = 'rejected' WHERE id = $1 RETURNING *",
        [id]
      );

      if (result.rows.length === 0) {
        return res.status(404).json({ error: "Property not found" });
      }

      res.json({
        message: "Property rejected successfully",
        property: result.rows[0],
      });
    } catch (error) {
      console.error("Error rejecting property:", error);
      res.status(500).json({ error: "Failed to reject property" });
    }
  }
);

module.exports = router;

